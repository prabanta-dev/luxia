//
// A unit of a library for the tests, not the standard one: found with
// --stdlib=tests/units/std, in a space of its own.
unit Texts;

interface

function Times(s: String; n: Int64): String;

implementation

function Times(s: String; n: Int64): String;
begin
  var r: String := "";
  for var i: Int64 := 1 to n do
    r := r & s;
  end;
  return r;
end Times;

end Texts.
