//
// The second unit of the defective library qualified: Twice, not
// Alpha.Twice (rule 2).
unit Beta;

interface

uses Alpha;

function Four(x: Int64): Int64;

implementation

function Four(x: Int64): Int64;
begin
  return Twice(Alpha.Twice(x));
end Four;

end Beta.
