//
// A defective library for test_luxia: an initialisation that calls C
// (rule 3: a program using it does not compile under no_external).
unit Clock;

interface

var Started: Int64;

implementation

function Seconds(t: CPointer): Int64;
  external "c" name "time";

begin
  Started := Seconds(nil);
end Clock.
