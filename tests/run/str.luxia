//
// str for the types of a program (specification § 9.4): records,
// enumerations, distinct types and arrays written by write and writeln
// with the str the program adds, a width on the string it gives, str
// called by name.
program Strings2;
type
  Vec = record x, y: Int32; end;
  Colour = (Red, Green, Blue);
  Money = new Int64;
  Row = array[Int32 range 1..3] of Int32;
function str(v: Vec): String; overload;
begin
  return "(" & str(v.x) & ", " & str(v.y) & ")";
end str;
function str(c: Colour): String; overload;
begin
  case c of
    when Red: return "red";
    when Green: return "green";
  else
    return "blue";
  end;
end str;
function str(m: Money): String; overload;
begin
  return str(Int64(m)) & " EUR";
end str;
function str(r: Row): String; overload;
begin
  return str(r[1]) & "/" & str(r[2]) & "/" & str(r[3]);
end str;
var
  v: Vec := {x: 1; y: 2};
  m: Money := 5;
  r: Row := {7, 8, 9};
begin
  writeln(v, " ", Green, " ", m, " ", r);
  writeln("[", v:10, "]", str(Blue), " ", length(str(m)));
end.
