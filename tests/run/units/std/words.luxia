//
// a unit of the standard library, in the directory of --stdlib=DIR.
unit Words;

interface

function Times(s: String; n: Int64): String;

implementation

function Times(s: String; n: Int64): String;
begin
  var r: String := "";
  for var i: Int64 := 1 to n do
    r := r & s;
  end;
  return r;
end Times;

end Words.
