//
// Procedural types (§ 3.15): a sort with a Compare, a table of actions
// in a typed constant, a function that gives a routine, = and <>, and a
// call through nil that stops the program
program Procedures;

type
  Compare = function(a, b: Int32): Boolean;
  Action = procedure(var n: Int64);
  Vec = array[Int32 range 1..5] of Int32;

function Less(a, b: Int32): Boolean; begin return a < b; end Less;
function More(x, y: Int32): Boolean; begin return x > y; end More;
procedure Twice(var n: Int64); begin n := n * 2; end Twice;
procedure Inc(var n: Int64); begin n := n + 1; end Inc;

procedure Sort(var v: array[Int32 range <>] of Int32; before: Compare);
begin
  for var i: Int32 := low(v) to high(v) - 1 do
    for var j: Int32 := i + 1 to high(v) do
      if before(v[j], v[i]) then
        var t: Int32 := v[i];
        v[i] := v[j];
        v[j] := t;
      end;
    end;
  end;
end Sort;

const Ops: array[Int32 range 1..2] of Action = {Twice, Inc};
const First: Compare = Less;

var data: Vec := {3, 1, 4, 1, 5};
    cmp: Compare := Less;
    act: Action;
    n: Int64 := 5;

function Pick(up: Boolean): Compare;
begin
  if up then return Less; end;
  return More;
end Pick;

begin
  Sort(data, More);
  for var i: Int32 := 1 to 5 do write(data[i], " "); end;
  writeln();
  Sort(data, cmp);
  for var i: Int32 := 1 to 5 do write(data[i], " "); end;
  writeln();
  writeln(cmp(1, 2), " ", Pick(false)(1, 2), " ", First = cmp, " ", cmp = More, " ", cmp <> nil);
  for var i: Int32 := 1 to 2 do Ops[i](n); end;
  writeln(n);
  act := Ops[2];
  act(n);
  writeln(n, " ", act = Inc);
  act := nil;
  writeln(act = nil);
  act(n);
  writeln("never");
end Procedures.
