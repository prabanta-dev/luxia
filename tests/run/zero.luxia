//
// The sign of a negative value in fixed notation, also when it rounds to
// zero, and of a negative zero (specification § 9.1); a NaN is nan.
program Zero;

var
  small: Float64 := -0.004;
  half: Float32 := -0.004;
  big: Float64 := 0.0;

begin
  var nz := small * 0.0;
  writeln(small:0:2, " ", half:0:2, " ", nz:0:2, " ", nz:6:1, " ", nz);
  writeln(small:0:3, " ", (-small):0:2, " ", big:0:2, " ", str(nz));
  writeln((nz / nz):0:2, " ", (big / big):5:1);
end.
