//
// Typed constants and variables ready at once: their initial values are
// the bytes of their globals, with the Strings as relocations. Main
// stores a BigInt other than 0, fills a run of one value of 256 bytes or
// more in a loop, and stores what lies past a long run of zeros. Every
// form of aggregate, each value printed.
program Data;

type
  Small = Int8 range -3..9;
  Color = (Red, Green, Blue);
  Entry = record
    k: BigInt;
    name: String;
    tag: Small;
  end;
  Point = record
    x: Float32;
    y: Float64;
    on: Boolean;
    c: Char;
    hue: Color;
  end;
  Row = array[Int32 range 1..6] of Int16;
  Words = array[Int32 range 0..3] of String;
  Grid = array[Int32 range 1..2, Int32 range 1..3] of Int64;
  Points = array[Int32 range 1..2] of Point;
  Large = array[Int64 range 1..140000] of Int64;
  Sparse = array[Int32 range 1..1000] of Int32;
  Tags = array[Int32 range 1..40] of Entry;
  Rows = array[Int32 range 1..30] of Row;
  Word = record s: String; n: Int32; end;
  Words2 = array[Int32 range 1..50] of Word;
  Line = array[Int32 range 1..100] of Int32;
  Lines2 = array[Int32 range 1..4] of Line;

const
  Big: Entry = {k: 123456789012345678901234567890; name: "big"; tag: -3};
  Zero: Entry = {k: 0; name: ""; tag: 9};
  Pos: Row = {1, 2, else -7};
  Named: Row = {6: 60, 2..3: 23, else 5};
  Exact: Row = {3..6: 36, 1: 10, 2: 20};
  Table: Large = {1: 11, else 4};
  Gap: Sparse = {1: 1, 2: 2, 999: 9, else 0};
  Middle: Sparse = {1: 1, 2..900: 7, 1000: 10, else 0};
  Labels: Tags = {3: {k: 0; name: "three"; tag: 3},
                  else {k: 5; name: "rest"; tag: -1}};
  Lines: Rows = {1: {else 1}, else {6: 6, else 2}};
  Said: Words2 = {1: {s: "one"; n: 1}, else {s: "w"; n: 3}};
  Planes: Lines2 = {else {1: 9, else 1}};

var
  w, w2: Words := {"zero", "one", else "many"};
  g: Grid := {{1, 2, 3}, {4, 5, 6}};
  ps: Points := {{x: 1.5; y: -0.1; on: true; c: 'q'; hue: Blue},
                 {x: -2.25; y: 1e300; on: false; c: 'Z'; hue: Green}};
  count: Int32 := -42;
  ratio: Float32 := 0.1;
  title: String := "data";
  b: BigInt := 77;

procedure Local();
const
  Inner: Row = {else 3};
begin
  writeln(Inner[1], " ", Inner[6]);
end Local;

begin
  writeln(Big.k, " ", Big.name, " ", Big.tag);
  writeln(Zero.k, " [", Zero.name, "] ", Zero.tag);
  for var i: Int32 := 1 to 6 do
    writeln(Pos[i], " ", Named[i], " ", Exact[i]);
  end;
  writeln(Table[1], " ", Table[140000]);
  for var i: Int32 := 0 to 3 do
    writeln(w[i], " ", w2[i]);
  end;
  w[1] := "changed";
  writeln(w[1], " ", w2[1]);
  writeln(g[1, 1], " ", g[1, 3], " ", g[2, 1], " ", g[2, 3]);
  for var i: Int32 := 1 to 2 do
    writeln(ps[i].x, " ", ps[i].y, " ", ps[i].on, " ", ps[i].c, " ",
            ord(ps[i].hue));
  end;
  writeln(count, " ", ratio, " ", title, " ", b);
  writeln(Gap[1], " ", Gap[2], " ", Gap[3], " ", Gap[998], " ", Gap[999],
          " ", Gap[1000]);
  writeln(Middle[1], " ", Middle[2], " ", Middle[900], " ", Middle[901],
          " ", Middle[1000]);
  writeln(Labels[1].k, " ", Labels[1].name, " ", Labels[3].name, " ",
          Labels[40].tag, " ", Labels[3].tag);
  writeln(Lines[1][6], " ", Lines[2][1], " ", Lines[30][6], " ",
          Lines[30][5]);
  writeln(Said[1].s, " ", Said[2].s, Said[50].s, " ", Said[50].n);
  writeln(Planes[1][1], " ", Planes[1][2], " ", Planes[4][1], " ",
          Planes[4][100]);
  Local();
end.
